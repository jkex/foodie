---
import AppLayout from '../layouts/AppLayout.astro';
import { detectLocale, translations, type TranslationKey } from '../lib/preferences';

const locale = detectLocale(Astro.request.headers.get('accept-language'));
const t = (key: TranslationKey) => translations[locale][key];
const panelClass = 'rounded-xl border border-neutral-200 bg-white p-4 shadow-xs dark:border-neutral-800 dark:bg-neutral-950 sm:p-5';
const inputClass = 'h-10 w-full rounded-md border border-neutral-200 bg-white px-3 py-2 text-sm font-normal text-neutral-950 shadow-xs outline-none transition focus:border-neutral-400 focus:ring-2 focus:ring-neutral-950/10 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-50 dark:focus:border-neutral-500 dark:focus:ring-white/10';
---

<AppLayout active="settings">
	<section class="grid gap-4">
		<h1 data-i18n="settingsNav" class="m-0 text-2xl font-semibold tracking-tight sm:text-3xl">{t('settingsNav')}</h1>
		<section class={`${panelClass} grid gap-4`}>
			<label class="grid gap-1.5 text-sm font-medium text-neutral-800 dark:text-neutral-200">
				<span data-i18n="language">{t('language')}</span>
				<select id="locale-select" class={inputClass}>
					<option value="en" selected={locale === 'en'} data-i18n="english">{t('english')}</option>
					<option value="de" selected={locale === 'de'} data-i18n="german">{t('german')}</option>
				</select>
			</label>
			<label class="grid gap-1.5 text-sm font-medium text-neutral-800 dark:text-neutral-200">
				<span data-i18n="theme">{t('theme')}</span>
				<select id="theme-select" class={inputClass}>
					<option value="system" data-i18n="system">{t('system')}</option>
					<option value="light" data-i18n="light">{t('light')}</option>
					<option value="dark" data-i18n="dark">{t('dark')}</option>
				</select>
			</label>
		</section>
	</section>
</AppLayout>
