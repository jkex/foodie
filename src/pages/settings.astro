---
import { LogOut, Sparkles } from '@lucide/astro';
import PageHeader from '../components/PageHeader.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Field from '../components/ui/Field.astro';
import Input from '../components/ui/Input.astro';
import Panel from '../components/ui/Panel.astro';
import Select from '../components/ui/Select.astro';
import AppLayout from '../layouts/AppLayout.astro';
import {
	AI_PROVIDERS,
	DEFAULT_MODELS,
	getAiSettings,
	getProviderModel,
	PROVIDER_KEY_URLS,
	PROVIDER_LABELS,
	type AiSettings,
} from '../lib/ai';
import { getDb } from '../lib/db';
import { useTranslations } from '../lib/i18n';

let ai: AiSettings | null = null;
let providerModels = { ...DEFAULT_MODELS };
try {
	const db = getDb();
	ai = await getAiSettings(db, Astro.locals.userId);
	providerModels = Object.fromEntries(
		await Promise.all(AI_PROVIDERS.map(async (provider) => [provider, await getProviderModel(db, Astro.locals.userId, provider)])),
	) as typeof DEFAULT_MODELS;
} catch {
	// Without a database binding the AI section just shows as not configured.
}

const { locale, t } = useTranslations(Astro);
const activeProvider = ai?.active?.provider ?? 'anthropic';
const isAiConfigured = Boolean(ai?.providers.length);
---

<AppLayout active="settings" title={t('settingsNav')}>
	<section class="grid gap-4">
		<PageHeader title={t('settingsNav')} />
		<Panel class="grid gap-4">
			<Field label={t('language')}>
				<Select id="locale-select">
					<option value="en" selected={locale === 'en'}>{t('english')}</option>
					<option value="de" selected={locale === 'de'}>{t('german')}</option>
				</Select>
			</Field>
			<Field label={t('theme')}>
				<Select id="theme-select">
					<option value="system">{t('system')}</option>
					<option value="light">{t('light')}</option>
					<option value="dark">{t('dark')}</option>
				</Select>
			</Field>
			<form method="post" action="/logout">
				<Button variant="secondary">
					<LogOut size={16} stroke-width={2} />
					{t('signOut')}
				</Button>
			</form>
		</Panel>

		<Panel class="grid gap-4">
			<div class="flex items-center justify-between gap-3">
				<div class="flex items-center gap-2">
					<Sparkles size={18} stroke-width={2} class="text-primary-600 dark:text-primary-400" />
					<h2 class="m-0 text-lg font-semibold tracking-tight">{t('aiSection')}</h2>
				</div>
				<Badge tone={isAiConfigured ? 'primary' : 'neutral'}>{isAiConfigured ? t('aiConfigured') : t('aiNotConfigured')}</Badge>
			</div>
			<p class="m-0 text-sm text-neutral-500 dark:text-neutral-400">{t('aiSectionHelp')}</p>
			<form method="post" action="/api/ai/settings" class="grid gap-4">
				<input type="hidden" name="action" value="save" />
				<Field label={t('aiProvider')}>
					<Select name="active_provider">
						{
							AI_PROVIDERS.map((item) => (
								<option value={item} selected={activeProvider === item}>
									{PROVIDER_LABELS[item]}
								</option>
							))
						}
					</Select>
				</Field>
				<div class="grid gap-4">
					{
						AI_PROVIDERS.map((item) => (
							<Panel class="grid gap-4 border border-neutral-200/70 bg-white/70 p-4 shadow-none dark:border-neutral-800 dark:bg-neutral-900/40">
								<div class="flex items-start justify-between gap-3">
									<div class="grid gap-1 min-w-0">
										<div class="font-semibold tracking-tight">{PROVIDER_LABELS[item]}</div>
										<a
											class="text-xs text-primary-600 underline dark:text-primary-400 break-all"
											href={PROVIDER_KEY_URLS[item]}
											target="_blank"
											rel="noreferrer"
										>
											{PROVIDER_KEY_URLS[item]}
										</a>
									</div>
									<Badge tone={activeProvider === item ? 'primary' : 'neutral'}>
										{activeProvider === item ? t('acceptedBadge') : t('draftBadge')}
									</Badge>
								</div>
								<div class="grid gap-4 sm:grid-cols-2">
									<Field label={t('aiApiKey')}>
										<Input
											type="password"
											name={`key_${item}`}
											autocomplete="off"
											placeholder={item === 'gemini' ? 'AIza...' : item === 'anthropic' ? 'sk-ant-...' : 'sk-...'}
										/>
									</Field>
									<Field label={t('aiModel')}>
										<Input name={`model_${item}`} value={providerModels[item]} placeholder={DEFAULT_MODELS[item]} />
									</Field>
								</div>
							</Panel>
						))
					}
				</div>
				{isAiConfigured && <p class="m-0 -mt-2 text-xs text-neutral-500 dark:text-neutral-400">{t('aiApiKeyKeepHelp')}</p>}
				<div class="flex flex-wrap gap-2">
					<Button>{t('aiSave')}</Button>
				</div>
			</form>
			{
				ai?.providers.map((provider) => (
					<form method="post" action="/api/ai/settings">
						<input type="hidden" name="action" value="delete" />
						<input type="hidden" name="provider" value={provider} />
						<Button variant="danger">{t('aiRemoveKey').replace('{provider}', PROVIDER_LABELS[provider])}</Button>
					</form>
				))
			}
		</Panel>
	</section>

	<script is:inline>
		// Locale lives in a cookie so the server renders the right language; changing it reloads.
		const localeSelect = document.getElementById('locale-select');
		localeSelect?.addEventListener('change', () => {
			document.cookie = `foodie.locale=${localeSelect.value}; path=/; max-age=31536000; samesite=lax`;
			location.reload();
		});

		// Theme is client-only and lives in localStorage.
		const themeSelect = document.getElementById('theme-select');
		const media = window.matchMedia('(prefers-color-scheme: dark)');
		function applyTheme(theme) {
			const safeTheme = ['system', 'light', 'dark'].includes(theme) ? theme : 'system';
			document.documentElement.classList.toggle('dark', safeTheme === 'dark' || (safeTheme === 'system' && media.matches));
			if (themeSelect) themeSelect.value = safeTheme;
		}
		applyTheme(localStorage.getItem('foodie.theme') || 'system');
		themeSelect?.addEventListener('change', () => {
			localStorage.setItem('foodie.theme', themeSelect.value);
			applyTheme(themeSelect.value);
		});
		media.addEventListener('change', () => applyTheme(localStorage.getItem('foodie.theme') || 'system'));
	</script>
</AppLayout>
