---
import AppLayout from '../layouts/AppLayout.astro';
import { getDb, latestMealPlan, shoppingListForPlan, type ShoppingListItem } from '../lib/db';
import { detectLocale, translations, type TranslationKey } from '../lib/preferences';

let shoppingList: ShoppingListItem[] = [];
let databaseError = '';

try {
	const db = getDb();
	const mealPlan = await latestMealPlan(db);
	if (mealPlan) {
		shoppingList = await shoppingListForPlan(db, mealPlan.id);
	}
} catch (error) {
	databaseError = error instanceof Error ? error.message : 'Unknown database error';
}

const locale = detectLocale(Astro.request.headers.get('accept-language'));
const t = (key: TranslationKey) => translations[locale][key];
const panelClass = 'rounded-xl border border-neutral-200 bg-white p-4 shadow-xs dark:border-neutral-800 dark:bg-neutral-950 sm:p-5';
const mutedTextClass = 'text-sm text-neutral-500 dark:text-neutral-400';
const rowClass = 'rounded-lg border border-neutral-200 bg-neutral-50/70 p-3 dark:border-neutral-800 dark:bg-neutral-900/50';

function formatQuantity(value: number) {
	return Number.isInteger(value) ? String(value) : value.toFixed(2).replace(/0+$/, '').replace(/\.$/, '');
}
---

<AppLayout active="shopping">
	<section class="grid gap-4">
		<h1 data-i18n="shoppingList" class="m-0 text-2xl font-semibold tracking-tight sm:text-3xl">{t('shoppingList')}</h1>
		{databaseError && <p class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-950 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-100">{databaseError}</p>}
		<section class={panelClass}>
			{shoppingList.length > 0 ? (
				<ul class="grid list-none gap-3 p-0">
					{shoppingList.map((item) => (
						<li class={`${rowClass} flex items-center gap-3`}>
							<input type="checkbox" class="h-4 w-4 rounded border-neutral-300 accent-neutral-950 dark:accent-neutral-50" />
							<span>
								<strong>{formatQuantity(item.total_quantity)} {item.unit}</strong> {item.name}
								<small class={mutedTextClass}>{item.category}{item.notes ? ` - ${item.notes}` : ''}</small>
							</span>
						</li>
					))}
				</ul>
			) : (
				<p data-i18n="generatePlanForShopping" class="mt-0 text-sm text-neutral-500 dark:text-neutral-400">{t('generatePlanForShopping')}</p>
			)}
		</section>
	</section>
</AppLayout>
