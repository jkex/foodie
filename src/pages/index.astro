---
import {
	getDb,
	latestMealPlan,
	listMealPlanItems,
	listRecipeIngredients,
	listRecipes,
	shoppingListForPlan,
	type MealPlan,
	type MealPlanItem,
	type Recipe,
	type RecipeIngredient,
	type ShoppingListItem,
} from '../lib/db';
import { detectLocale, translations, type Locale, type TranslationKey } from '../lib/preferences';
import '../styles/global.css';

let recipes: Recipe[] = [];
let ingredientsByRecipe = new Map<number, RecipeIngredient[]>();
let mealPlan: MealPlan | null = null;
let mealPlanItems: MealPlanItem[] = [];
let shoppingList: ShoppingListItem[] = [];
let databaseError = '';

try {
	const db = getDb();
	recipes = await listRecipes(db);
	ingredientsByRecipe = new Map(await Promise.all(recipes.map(async (recipe) => [recipe.id, await listRecipeIngredients(db, recipe.id)])));
	mealPlan = await latestMealPlan(db);
	if (mealPlan) {
		mealPlanItems = await listMealPlanItems(db, mealPlan.id);
		shoppingList = await shoppingListForPlan(db, mealPlan.id);
	}
} catch (error) {
	databaseError = error instanceof Error ? error.message : 'Unknown database error';
}

const today = new Date().toISOString().slice(0, 10);
const locale = detectLocale(Astro.request.headers.get('accept-language'));
const t = (key: TranslationKey) => translations[locale][key];

function formatQuantity(value: number) {
	return Number.isInteger(value) ? String(value) : value.toFixed(2).replace(/0+$/, '').replace(/\.$/, '');
}

const panelClass = 'rounded-xl border border-neutral-200 bg-white p-4 shadow-xs dark:border-neutral-800 dark:bg-neutral-950 sm:p-5';
const inputClass =
	'h-10 w-full rounded-md border border-neutral-200 bg-white px-3 py-2 text-sm font-normal text-neutral-950 shadow-xs outline-none transition focus:border-neutral-400 focus:ring-2 focus:ring-neutral-950/10 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-50 dark:focus:border-neutral-500 dark:focus:ring-white/10';
const textareaClass =
	'w-full rounded-md border border-neutral-200 bg-white px-3 py-2 text-sm font-normal text-neutral-950 shadow-xs outline-none transition focus:border-neutral-400 focus:ring-2 focus:ring-neutral-950/10 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-50 dark:focus:border-neutral-500 dark:focus:ring-white/10';
const labelClass = 'grid gap-1.5 text-sm font-medium text-neutral-800 dark:text-neutral-200';
const buttonClass =
	'inline-flex min-h-10 cursor-pointer items-center justify-center rounded-md bg-neutral-950 px-4 py-2 text-sm font-medium text-white shadow-xs transition hover:bg-neutral-800 disabled:pointer-events-none disabled:opacity-50 dark:bg-neutral-50 dark:text-neutral-950 dark:hover:bg-neutral-200';
const secondaryButtonClass =
	'inline-flex min-h-10 cursor-pointer items-center justify-center rounded-md border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-950 shadow-xs transition hover:bg-neutral-100 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-50 dark:hover:bg-neutral-900';
const mutedTextClass = 'text-sm text-neutral-500 dark:text-neutral-400';
const rowClass = 'rounded-lg border border-neutral-200 bg-neutral-50/70 p-3 dark:border-neutral-800 dark:bg-neutral-900/50';
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0a0a0a" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="Foodie" />
		<title>Foodie</title>
		<script is:inline>
			const storedTheme = localStorage.getItem('foodie.theme') || 'system';
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			document.documentElement.classList.toggle('dark', storedTheme === 'dark' || (storedTheme === 'system' && prefersDark));
		</script>
	</head>
	<body class="m-0 bg-neutral-50 font-sans text-neutral-950 antialiased dark:bg-neutral-950 dark:text-neutral-50">
		<header class="mx-auto flex max-w-6xl flex-col gap-4 px-4 pt-[calc(1rem+env(safe-area-inset-top))] sm:px-6 md:flex-row md:items-end md:justify-between md:px-8">
			<div class="grid gap-2">
				<div class="flex items-center gap-2">
					<span class="grid h-8 w-8 place-items-center rounded-lg bg-neutral-950 text-sm font-semibold text-white dark:bg-neutral-50 dark:text-neutral-950">F</span>
					<p class="m-0 text-sm font-semibold text-neutral-600 dark:text-neutral-400">Foodie</p>
				</div>
				<h1 data-i18n="appTitle" class="m-0 max-w-3xl text-2xl leading-tight font-semibold tracking-tight sm:text-3xl md:text-4xl">{t('appTitle')}</h1>
			</div>
			<div id="settings" class="grid scroll-mt-4 grid-cols-2 gap-3 rounded-xl border border-neutral-200 bg-white p-3 text-sm shadow-xs dark:border-neutral-800 dark:bg-neutral-950 md:min-w-80">
				<label class="grid gap-1 font-bold">
					<span data-i18n="language">{t('language')}</span>
					<select id="locale-select" class={inputClass}>
						<option value="en" selected={locale === 'en'} data-i18n="english">{t('english')}</option>
						<option value="de" selected={locale === 'de'} data-i18n="german">{t('german')}</option>
					</select>
				</label>
				<label class="grid gap-1 font-bold">
					<span data-i18n="theme">{t('theme')}</span>
					<select id="theme-select" class={inputClass}>
						<option value="system" data-i18n="system">{t('system')}</option>
						<option value="light" data-i18n="light">{t('light')}</option>
						<option value="dark" data-i18n="dark">{t('dark')}</option>
					</select>
				</label>
			</div>
		</header>

		<main class="mx-auto max-w-6xl p-4 pb-[calc(5.75rem+env(safe-area-inset-bottom))] sm:p-6 sm:pb-[calc(6rem+env(safe-area-inset-bottom))] md:p-8">
			{databaseError && (
				<section class="mb-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-950 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-100">
					<h2 data-i18n="databaseSetupNeeded" class="mt-0 text-base font-semibold">{t('databaseSetupNeeded')}</h2>
					<p class="mt-0">{databaseError}</p>
					<p><span data-i18n="databaseSetupHelp">{t('databaseSetupHelp')}</span> <code>DB</code> <span data-i18n="beforeUsingApp">{t('beforeUsingApp')}</span></p>
				</section>
			)}

			<section id="plan" class="my-4 grid scroll-mt-4 items-start gap-4 lg:grid-cols-[0.9fr_1.1fr]">
				<div class={panelClass}>
					<div class="mb-4 flex items-center justify-between gap-3">
						<h2 data-i18n="generatePlan" class="m-0 text-lg font-semibold tracking-tight">{t('generatePlan')}</h2>
						<span class="rounded-full border border-neutral-200 px-2 py-1 text-xs font-medium text-neutral-500 dark:border-neutral-800 dark:text-neutral-400">7d</span>
					</div>
					<form method="post" action="/api/plans" class="grid gap-4">
						<label class={labelClass}>
							<span data-i18n="startDate">{t('startDate')}</span>
							<input class={inputClass} type="date" name="start_date" value={today} required />
						</label>
						<label class={labelClass}>
							<span data-i18n="cookedFoodDays">{t('cookedFoodDays')}</span>
							<input class={inputClass} type="number" name="planned_day_count" value="7" min="1" max="14" required />
						</label>
						<label class={labelClass}>
							<span data-i18n="people">{t('people')}</span>
							<input class={inputClass} type="number" name="people_count" value="2" min="1" max="20" required />
						</label>
						<button data-i18n="generateDraft" class={buttonClass} type="submit" disabled={Boolean(databaseError) || recipes.length === 0}>{t('generateDraft')}</button>
					</form>
				</div>

				<div class={panelClass}>
					<div class="mb-4 flex items-center justify-between gap-3">
						<h2 data-i18n="latestPlan" class="m-0 text-lg font-semibold tracking-tight">{t('latestPlan')}</h2>
						{mealPlan && <span class="rounded-full bg-neutral-100 px-2 py-1 text-xs font-medium text-neutral-600 dark:bg-neutral-900 dark:text-neutral-300">{mealPlan.status}</span>}
					</div>
					{mealPlan ? (
						<>
							<p class={`${mutedTextClass} mt-0`}>
								<strong>{mealPlan.planned_day_count}</strong> <span data-i18n="cookedFoodDaysFor">{t('cookedFoodDaysFor')}</span> <strong>{mealPlan.people_count}</strong> <span data-i18n="peopleStarting">{t('peopleStarting')}</span> <strong>{mealPlan.start_date}</strong>.
							</p>
							<ol class="grid list-none gap-3 p-0">
								{mealPlanItems.map((item) => (
									<li class={`${rowClass} grid grid-cols-[auto_1fr] gap-3`}>
										<span class="grid h-9 w-9 place-items-center rounded-md bg-white text-sm font-semibold shadow-xs dark:bg-neutral-950"><span data-i18n="day" class="sr-only">{t('day')}</span>{item.start_day_index + 1}</span>
										<span>
											<strong class="block text-sm font-medium">{item.recipe_name}</strong>
											<small class={mutedTextClass}>{item.day_count} <span data-i18n={item.day_count === 1 ? 'daySingular' : 'dayPlural'}>{item.day_count === 1 ? t('daySingular') : t('dayPlural')}</span>, {item.serving_multiplier.toFixed(2)}x <span data-i18n="ingredientsMultiplier">{t('ingredientsMultiplier')}</span></small>
										</span>
									</li>
								))}
							</ol>
							{mealPlan.status === 'draft' && (
								<form method="post" action="/api/plans/commit">
									<input type="hidden" name="meal_plan_id" value={mealPlan.id} />
									<button data-i18n="acceptPlan" class={buttonClass} type="submit">{t('acceptPlan')}</button>
								</form>
							)}
						</>
					) : (
						<p data-i18n="noPlan" class={`${mutedTextClass} mt-0`}>{t('noPlan')}</p>
					)}
				</div>
			</section>

			<section id="recipes" class={`${panelClass} scroll-mt-4`}>
				<div class="mb-4 flex items-center justify-between gap-3">
					<h2 data-i18n="addRecipe" class="m-0 text-lg font-semibold tracking-tight">{t('addRecipe')}</h2>
					<span class="rounded-full bg-neutral-100 px-2 py-1 text-xs font-medium text-neutral-600 dark:bg-neutral-900 dark:text-neutral-300">{recipes.length}</span>
				</div>
				<form method="post" action="/api/recipes" class="grid gap-4 md:grid-cols-3">
					<label class={labelClass}>
						<span data-i18n="name">{t('name')}</span>
						<input data-i18n-placeholder="recipeNamePlaceholder" class={inputClass} name="name" required placeholder={t('recipeNamePlaceholder')} />
					</label>
					<label class={labelClass}>
						<span data-i18n="baseServings">{t('baseServings')}</span>
						<input class={inputClass} type="number" name="base_servings" value="2" min="1" step="0.5" required />
					</label>
					<label class={labelClass}>
						<span data-i18n="defaultDays">{t('defaultDays')}</span>
						<input class={inputClass} type="number" name="default_days" value="1" min="1" max="7" required />
					</label>
					<label class={`${labelClass} md:col-span-3`}>
						<span data-i18n="description">{t('description')}</span>
						<input data-i18n-placeholder="descriptionPlaceholder" class={inputClass} name="description" placeholder={t('descriptionPlaceholder')} />
					</label>
					<label class={`${labelClass} md:col-span-3`}>
						<span data-i18n="instructions">{t('instructions')}</span>
						<textarea data-i18n-placeholder="instructionsPlaceholder" class={textareaClass} name="instructions" rows="4" placeholder={t('instructionsPlaceholder')}></textarea>
					</label>
					<label class={`${labelClass} md:col-span-3`}>
						<span data-i18n="ingredients">{t('ingredients')}</span>
						<textarea data-i18n-placeholder="ingredientsPlaceholder" class={textareaClass} name="ingredients" rows="6" placeholder={t('ingredientsPlaceholder')}></textarea>
					</label>
					<button data-i18n="saveRecipe" class={buttonClass} type="submit" disabled={Boolean(databaseError)}>{t('saveRecipe')}</button>
				</form>
			</section>

			<section class="my-4 grid items-start gap-4 md:grid-cols-2">
				<div class={panelClass}>
					<h2 data-i18n="recipes" class="mt-0 text-lg font-semibold tracking-tight">{t('recipes')}</h2>
					{recipes.length > 0 ? (
						<div class="grid gap-3">
							{recipes.map((recipe) => (
								<article class={rowClass}>
									<div>
										<h3 class="mt-0 text-base font-medium">{recipe.name}</h3>
										<p class={`${mutedTextClass} mt-0`}>{recipe.description || t('noDescription')}</p>
										<small class={mutedTextClass}>{recipe.base_servings} <span data-i18n="baseServingsUsually">{t('baseServingsUsually')}</span> {recipe.default_days} <span data-i18n={recipe.default_days === 1 ? 'daySingular' : 'dayPlural'}>{recipe.default_days === 1 ? t('daySingular') : t('dayPlural')}</span></small>
									</div>
									<ul class="my-3 grid gap-1 pl-5 text-sm text-neutral-700 dark:text-neutral-300">
										{(ingredientsByRecipe.get(recipe.id) ?? []).map((ingredient) => (
											<li>{ingredient.quantity} {ingredient.unit} {ingredient.name}</li>
										))}
									</ul>
									<form method="post" action="/api/recipes">
										<input type="hidden" name="action" value="delete" />
										<input type="hidden" name="id" value={recipe.id} />
										<button data-i18n="delete" type="submit" class={secondaryButtonClass}>{t('delete')}</button>
									</form>
								</article>
							))}
						</div>
					) : (
						<p data-i18n="noRecipes" class="mt-0">{t('noRecipes')}</p>
					)}
				</div>

				<div id="shopping" class={`${panelClass} scroll-mt-4`}>
					<h2 data-i18n="shoppingList" class="mt-0 text-lg font-semibold tracking-tight">{t('shoppingList')}</h2>
					{shoppingList.length > 0 ? (
						<ul class="grid list-none gap-3 p-0">
							{shoppingList.map((item) => (
								<li class={`${rowClass} flex items-center gap-3`}>
									<input type="checkbox" class="h-4 w-4 rounded border-neutral-300 accent-neutral-950 dark:accent-neutral-50" />
									<span>
										<strong>{formatQuantity(item.total_quantity)} {item.unit}</strong> {item.name}
										<small class={mutedTextClass}>{item.category}{item.notes ? ` - ${item.notes}` : ''}</small>
									</span>
								</li>
							))}
						</ul>
					) : (
						<p data-i18n="generatePlanForShopping" class="mt-0">{t('generatePlanForShopping')}</p>
					)}
				</div>
			</section>
		</main>
		<nav class="fixed inset-x-0 bottom-0 z-20 border-t border-neutral-200 bg-white/95 px-2 pt-2 pb-[calc(0.5rem+env(safe-area-inset-bottom))] shadow-lg backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/95 md:hidden" aria-label="Primary">
			<div class="mx-auto grid max-w-lg grid-cols-4 gap-1">
				<a href="#plan" class="rounded-md px-2 py-2 text-center text-xs font-medium text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-900">
					<span class="block text-base leading-none">01</span>
					<span data-i18n="planNav">{t('planNav')}</span>
				</a>
				<a href="#recipes" class="rounded-md px-2 py-2 text-center text-xs font-medium text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-900">
					<span class="block text-base leading-none">02</span>
					<span data-i18n="recipesNav">{t('recipesNav')}</span>
				</a>
				<a href="#shopping" class="rounded-md px-2 py-2 text-center text-xs font-medium text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-900">
					<span class="block text-base leading-none">03</span>
					<span data-i18n="shoppingNav">{t('shoppingNav')}</span>
				</a>
				<a href="#settings" class="rounded-md px-2 py-2 text-center text-xs font-medium text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-900">
					<span class="block text-base leading-none">04</span>
					<span data-i18n="settingsNav">{t('settingsNav')}</span>
				</a>
			</div>
		</nav>
		<script type="application/json" id="foodie-translations" set:html={JSON.stringify(translations)} />
		<script is:inline>
			const translations = JSON.parse(document.getElementById('foodie-translations').textContent || '{}');
			const localeSelect = document.getElementById('locale-select');
			const themeSelect = document.getElementById('theme-select');
			const media = window.matchMedia('(prefers-color-scheme: dark)');

			function browserLocale() {
				return navigator.language && navigator.language.toLowerCase().startsWith('de') ? 'de' : 'en';
			}

			function applyLocale(locale) {
				const safeLocale = translations[locale] ? locale : 'en';
				document.documentElement.lang = safeLocale;
				document.querySelectorAll('[data-i18n]').forEach((node) => {
					const key = node.getAttribute('data-i18n');
					if (key && translations[safeLocale][key]) node.textContent = translations[safeLocale][key];
				});
				document.querySelectorAll('[data-i18n-placeholder]').forEach((node) => {
					const key = node.getAttribute('data-i18n-placeholder');
					if (key && translations[safeLocale][key]) node.setAttribute('placeholder', translations[safeLocale][key]);
				});
				if (localeSelect) localeSelect.value = safeLocale;
			}

			function applyTheme(theme) {
				const safeTheme = ['system', 'light', 'dark'].includes(theme) ? theme : 'system';
				const dark = safeTheme === 'dark' || (safeTheme === 'system' && media.matches);
				document.documentElement.classList.toggle('dark', dark);
				if (themeSelect) themeSelect.value = safeTheme;
			}

			const storedLocale = localStorage.getItem('foodie.locale');
			const initialLocale = storedLocale || browserLocale();
			applyLocale(initialLocale);
			applyTheme(localStorage.getItem('foodie.theme') || 'system');

			localeSelect?.addEventListener('change', () => {
				localStorage.setItem('foodie.locale', localeSelect.value);
				applyLocale(localeSelect.value);
			});

			themeSelect?.addEventListener('change', () => {
				localStorage.setItem('foodie.theme', themeSelect.value);
				applyTheme(themeSelect.value);
			});

			media.addEventListener('change', () => {
				applyTheme(localStorage.getItem('foodie.theme') || 'system');
			});

			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(() => {});
				});
			}
		</script>
	</body>
</html>
