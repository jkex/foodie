---
import {
	getDb,
	latestMealPlan,
	listMealPlanItems,
	listRecipeIngredients,
	listRecipes,
	shoppingListForPlan,
	type MealPlan,
	type MealPlanItem,
	type Recipe,
	type RecipeIngredient,
	type ShoppingListItem,
} from '../lib/db';

let recipes: Recipe[] = [];
let ingredientsByRecipe = new Map<number, RecipeIngredient[]>();
let mealPlan: MealPlan | null = null;
let mealPlanItems: MealPlanItem[] = [];
let shoppingList: ShoppingListItem[] = [];
let databaseError = '';

try {
	const db = getDb(Astro.locals);
	recipes = await listRecipes(db);
	ingredientsByRecipe = new Map(await Promise.all(recipes.map(async (recipe) => [recipe.id, await listRecipeIngredients(db, recipe.id)])));
	mealPlan = await latestMealPlan(db);
	if (mealPlan) {
		mealPlanItems = await listMealPlanItems(db, mealPlan.id);
		shoppingList = await shoppingListForPlan(db, mealPlan.id);
	}
} catch (error) {
	databaseError = error instanceof Error ? error.message : 'Unknown database error';
}

const today = new Date().toISOString().slice(0, 10);

function formatQuantity(value: number) {
	return Number.isInteger(value) ? String(value) : value.toFixed(2).replace(/0+$/, '').replace(/\.$/, '');
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Foodie</title>
	</head>
	<body>
		<header class="app-header">
			<div>
				<p class="eyebrow">Foodie</p>
				<h1>Recipe rotation and shopping list</h1>
			</div>
		</header>

		<main>
			{databaseError && (
				<section class="notice">
					<h2>Database setup needed</h2>
					<p>{databaseError}</p>
					<p>Apply the D1 migration and bind the database as <code>DB</code> before using the app.</p>
				</section>
			)}

			<section class="layout">
				<div class="panel">
					<h2>Generate plan</h2>
					<form method="post" action="/api/plans" class="stack">
						<label>
							Start date
							<input type="date" name="start_date" value={today} required />
						</label>
						<label>
							Cooked-food days
							<input type="number" name="planned_day_count" value="7" min="1" max="14" required />
						</label>
						<label>
							People
							<input type="number" name="people_count" value="2" min="1" max="20" required />
						</label>
						<button type="submit" disabled={Boolean(databaseError) || recipes.length === 0}>Generate draft</button>
					</form>
				</div>

				<div class="panel">
					<h2>Latest plan</h2>
					{mealPlan ? (
						<>
							<p>
								<strong>{mealPlan.planned_day_count}</strong> cooked-food days for <strong>{mealPlan.people_count}</strong> people, starting <strong>{mealPlan.start_date}</strong>.
							</p>
							<ol class="plan-list">
								{mealPlanItems.map((item) => (
									<li>
										<span>Day {item.start_day_index + 1}</span>
										<strong>{item.recipe_name}</strong>
										<small>{item.day_count} day{item.day_count === 1 ? '' : 's'}, {item.serving_multiplier.toFixed(2)}x ingredients</small>
									</li>
								))}
							</ol>
							{mealPlan.status === 'draft' && (
								<form method="post" action="/api/plans/commit">
									<input type="hidden" name="meal_plan_id" value={mealPlan.id} />
									<button type="submit">Accept plan and rotate recipes</button>
								</form>
							)}
						</>
					) : (
						<p>No plan generated yet.</p>
					)}
				</div>
			</section>

			<section class="panel">
				<h2>Add recipe</h2>
				<form method="post" action="/api/recipes" class="recipe-form">
					<label>
						Name
						<input name="name" required placeholder="Pasta with tomato sauce" />
					</label>
					<label>
						Base servings
						<input type="number" name="base_servings" value="2" min="1" step="0.5" required />
					</label>
					<label>
						Default days
						<input type="number" name="default_days" value="1" min="1" max="7" required />
					</label>
					<label class="wide">
						Description
						<input name="description" placeholder="Quick weekday dinner" />
					</label>
					<label class="wide">
						Instructions
						<textarea name="instructions" rows="4" placeholder="Cook, combine, season."></textarea>
					</label>
					<label class="wide">
						Ingredients
						<textarea name="ingredients" rows="6" placeholder={`One per line: name | quantity | unit | category | note\nPasta | 200 | g | Dry goods |\nTomatoes | 1 | can | Canned | chopped`}></textarea>
					</label>
					<button type="submit" disabled={Boolean(databaseError)}>Save recipe</button>
				</form>
			</section>

			<section class="layout">
				<div class="panel">
					<h2>Recipes</h2>
					{recipes.length > 0 ? (
						<div class="recipe-list">
							{recipes.map((recipe) => (
								<article class="recipe-card">
									<div>
										<h3>{recipe.name}</h3>
										<p>{recipe.description || 'No description yet.'}</p>
										<small>{recipe.base_servings} base servings, usually {recipe.default_days} day{recipe.default_days === 1 ? '' : 's'}</small>
									</div>
									<ul>
										{(ingredientsByRecipe.get(recipe.id) ?? []).map((ingredient) => (
											<li>{ingredient.quantity} {ingredient.unit} {ingredient.name}</li>
										))}
									</ul>
									<form method="post" action="/api/recipes">
										<input type="hidden" name="action" value="delete" />
										<input type="hidden" name="id" value={recipe.id} />
										<button type="submit" class="secondary">Delete</button>
									</form>
								</article>
							))}
						</div>
					) : (
						<p>No recipes yet.</p>
					)}
				</div>

				<div class="panel">
					<h2>Shopping list</h2>
					{shoppingList.length > 0 ? (
						<ul class="shopping-list">
							{shoppingList.map((item) => (
								<li>
									<input type="checkbox" />
									<span>
										<strong>{formatQuantity(item.total_quantity)} {item.unit}</strong> {item.name}
										<small>{item.category}{item.notes ? ` - ${item.notes}` : ''}</small>
									</span>
								</li>
							))}
						</ul>
					) : (
						<p>Generate a plan to see the shopping list.</p>
					)}
				</div>
			</section>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		background: #f6f7f2;
		color: #1f2522;
	}

	body {
		margin: 0;
	}

	button,
	input,
	textarea {
		font: inherit;
	}

	button {
		border: 0;
		border-radius: 6px;
		background: #1f5f4a;
		color: white;
		cursor: pointer;
		font-weight: 700;
		padding: 0.75rem 1rem;
	}

	button:disabled {
		cursor: not-allowed;
		opacity: 0.5;
	}

	button.secondary {
		background: #5f342e;
	}

	input,
	textarea {
		border: 1px solid #c9d1c7;
		border-radius: 6px;
		box-sizing: border-box;
		padding: 0.7rem 0.8rem;
		width: 100%;
	}

	label {
		display: grid;
		gap: 0.35rem;
		font-weight: 700;
	}

	main,
	.app-header {
		margin: 0 auto;
		max-width: 1180px;
		padding: 2rem;
	}

	.app-header {
		padding-bottom: 0;
	}

	h1 {
		font-size: clamp(2rem, 5vw, 4rem);
		line-height: 1;
		margin: 0;
		max-width: 780px;
	}

	h2,
	h3,
	p {
		margin-top: 0;
	}

	.eyebrow {
		color: #1f5f4a;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.layout {
		align-items: start;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
		margin-block: 1rem;
	}

	.panel,
	.notice {
		background: white;
		border: 1px solid #dfe5dc;
		border-radius: 8px;
		padding: 1.25rem;
	}

	.notice {
		background: #fff7e0;
		border-color: #e3c567;
		margin-bottom: 1rem;
	}

	.stack,
	.recipe-form {
		display: grid;
		gap: 1rem;
	}

	.recipe-form {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
	}

	.wide {
		grid-column: 1 / -1;
	}

	.plan-list,
	.recipe-list,
	.shopping-list {
		display: grid;
		gap: 0.75rem;
		list-style: none;
		padding: 0;
	}

	.plan-list li,
	.shopping-list li,
	.recipe-card {
		border: 1px solid #e0e6df;
		border-radius: 8px;
		padding: 0.85rem;
	}

	.plan-list li,
	.shopping-list li {
		align-items: center;
		display: flex;
		gap: 0.75rem;
	}

	.plan-list span,
	small {
		color: #5f6f68;
		display: block;
	}

	.recipe-card {
		display: grid;
		gap: 0.75rem;
	}
</style>
