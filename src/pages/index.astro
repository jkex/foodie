---
import {
	getDb,
	latestMealPlan,
	listMealPlanItems,
	listRecipeIngredients,
	listRecipes,
	shoppingListForPlan,
	type MealPlan,
	type MealPlanItem,
	type Recipe,
	type RecipeIngredient,
	type ShoppingListItem,
} from '../lib/db';
import '../styles/global.css';

let recipes: Recipe[] = [];
let ingredientsByRecipe = new Map<number, RecipeIngredient[]>();
let mealPlan: MealPlan | null = null;
let mealPlanItems: MealPlanItem[] = [];
let shoppingList: ShoppingListItem[] = [];
let databaseError = '';

try {
	const db = getDb();
	recipes = await listRecipes(db);
	ingredientsByRecipe = new Map(await Promise.all(recipes.map(async (recipe) => [recipe.id, await listRecipeIngredients(db, recipe.id)])));
	mealPlan = await latestMealPlan(db);
	if (mealPlan) {
		mealPlanItems = await listMealPlanItems(db, mealPlan.id);
		shoppingList = await shoppingListForPlan(db, mealPlan.id);
	}
} catch (error) {
	databaseError = error instanceof Error ? error.message : 'Unknown database error';
}

const today = new Date().toISOString().slice(0, 10);

function formatQuantity(value: number) {
	return Number.isInteger(value) ? String(value) : value.toFixed(2).replace(/0+$/, '').replace(/\.$/, '');
}

const panelClass = 'rounded-lg border border-[#dfe5dc] bg-white p-5';
const inputClass = 'w-full rounded-md border border-[#c9d1c7] px-3 py-2 font-normal';
const labelClass = 'grid gap-1.5 font-bold';
const buttonClass = 'cursor-pointer rounded-md bg-[#1f5f4a] px-4 py-3 font-bold text-white disabled:cursor-not-allowed disabled:opacity-50';
const secondaryButtonClass = 'cursor-pointer rounded-md bg-[#5f342e] px-4 py-3 font-bold text-white';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Foodie</title>
	</head>
	<body class="m-0 bg-[#f6f7f2] font-sans text-[#1f2522]">
		<header class="mx-auto max-w-[1180px] px-8 pt-8">
			<div>
				<p class="mb-4 font-extrabold text-[#1f5f4a] uppercase">Foodie</p>
				<h1 class="m-0 max-w-3xl text-5xl leading-none font-bold md:text-6xl">Recipe rotation and shopping list</h1>
			</div>
		</header>

		<main class="mx-auto max-w-[1180px] p-8">
			{databaseError && (
				<section class="mb-4 rounded-lg border border-[#e3c567] bg-[#fff7e0] p-5">
					<h2 class="mt-0 text-2xl font-bold">Database setup needed</h2>
					<p class="mt-0">{databaseError}</p>
					<p>Apply the D1 migration and bind the database as <code>DB</code> before using the app.</p>
				</section>
			)}

			<section class="my-4 grid items-start gap-4 md:grid-cols-2">
				<div class={panelClass}>
					<h2 class="mt-0 text-2xl font-bold">Generate plan</h2>
					<form method="post" action="/api/plans" class="grid gap-4">
						<label class={labelClass}>
							Start date
							<input class={inputClass} type="date" name="start_date" value={today} required />
						</label>
						<label class={labelClass}>
							Cooked-food days
							<input class={inputClass} type="number" name="planned_day_count" value="7" min="1" max="14" required />
						</label>
						<label class={labelClass}>
							People
							<input class={inputClass} type="number" name="people_count" value="2" min="1" max="20" required />
						</label>
						<button class={buttonClass} type="submit" disabled={Boolean(databaseError) || recipes.length === 0}>Generate draft</button>
					</form>
				</div>

				<div class={panelClass}>
					<h2 class="mt-0 text-2xl font-bold">Latest plan</h2>
					{mealPlan ? (
						<>
							<p class="mt-0">
								<strong>{mealPlan.planned_day_count}</strong> cooked-food days for <strong>{mealPlan.people_count}</strong> people, starting <strong>{mealPlan.start_date}</strong>.
							</p>
							<ol class="grid list-none gap-3 p-0">
								{mealPlanItems.map((item) => (
									<li class="flex items-center gap-3 rounded-lg border border-[#e0e6df] p-3">
										<span class="block text-[#5f6f68]">Day {item.start_day_index + 1}</span>
										<strong>{item.recipe_name}</strong>
										<small class="block text-[#5f6f68]">{item.day_count} day{item.day_count === 1 ? '' : 's'}, {item.serving_multiplier.toFixed(2)}x ingredients</small>
									</li>
								))}
							</ol>
							{mealPlan.status === 'draft' && (
								<form method="post" action="/api/plans/commit">
									<input type="hidden" name="meal_plan_id" value={mealPlan.id} />
									<button class={buttonClass} type="submit">Accept plan and rotate recipes</button>
								</form>
							)}
						</>
					) : (
						<p class="mt-0">No plan generated yet.</p>
					)}
				</div>
			</section>

			<section class={panelClass}>
				<h2 class="mt-0 text-2xl font-bold">Add recipe</h2>
				<form method="post" action="/api/recipes" class="grid gap-4 md:grid-cols-3">
					<label class={labelClass}>
						Name
						<input class={inputClass} name="name" required placeholder="Pasta with tomato sauce" />
					</label>
					<label class={labelClass}>
						Base servings
						<input class={inputClass} type="number" name="base_servings" value="2" min="1" step="0.5" required />
					</label>
					<label class={labelClass}>
						Default days
						<input class={inputClass} type="number" name="default_days" value="1" min="1" max="7" required />
					</label>
					<label class={`${labelClass} md:col-span-3`}>
						Description
						<input class={inputClass} name="description" placeholder="Quick weekday dinner" />
					</label>
					<label class={`${labelClass} md:col-span-3`}>
						Instructions
						<textarea class={inputClass} name="instructions" rows="4" placeholder="Cook, combine, season."></textarea>
					</label>
					<label class={`${labelClass} md:col-span-3`}>
						Ingredients
						<textarea class={inputClass} name="ingredients" rows="6" placeholder={`One per line: name | quantity | unit | category | note\nPasta | 200 | g | Dry goods |\nTomatoes | 1 | can | Canned | chopped`}></textarea>
					</label>
					<button class={buttonClass} type="submit" disabled={Boolean(databaseError)}>Save recipe</button>
				</form>
			</section>

			<section class="my-4 grid items-start gap-4 md:grid-cols-2">
				<div class={panelClass}>
					<h2 class="mt-0 text-2xl font-bold">Recipes</h2>
					{recipes.length > 0 ? (
						<div class="grid gap-3">
							{recipes.map((recipe) => (
								<article class="grid gap-3 rounded-lg border border-[#e0e6df] p-3">
									<div>
										<h3 class="mt-0 text-xl font-bold">{recipe.name}</h3>
										<p class="mt-0">{recipe.description || 'No description yet.'}</p>
										<small class="block text-[#5f6f68]">{recipe.base_servings} base servings, usually {recipe.default_days} day{recipe.default_days === 1 ? '' : 's'}</small>
									</div>
									<ul>
										{(ingredientsByRecipe.get(recipe.id) ?? []).map((ingredient) => (
											<li>{ingredient.quantity} {ingredient.unit} {ingredient.name}</li>
										))}
									</ul>
									<form method="post" action="/api/recipes">
										<input type="hidden" name="action" value="delete" />
										<input type="hidden" name="id" value={recipe.id} />
										<button type="submit" class={secondaryButtonClass}>Delete</button>
									</form>
								</article>
							))}
						</div>
					) : (
						<p class="mt-0">No recipes yet.</p>
					)}
				</div>

				<div class={panelClass}>
					<h2 class="mt-0 text-2xl font-bold">Shopping list</h2>
					{shoppingList.length > 0 ? (
						<ul class="grid list-none gap-3 p-0">
							{shoppingList.map((item) => (
								<li class="flex items-center gap-3 rounded-lg border border-[#e0e6df] p-3">
									<input type="checkbox" />
									<span>
										<strong>{formatQuantity(item.total_quantity)} {item.unit}</strong> {item.name}
										<small class="block text-[#5f6f68]">{item.category}{item.notes ? ` - ${item.notes}` : ''}</small>
									</span>
								</li>
							))}
						</ul>
					) : (
						<p class="mt-0">Generate a plan to see the shopping list.</p>
					)}
				</div>
			</section>
		</main>
	</body>
</html>
