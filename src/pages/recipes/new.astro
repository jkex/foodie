---
import PageHeader from '../../components/PageHeader.astro';
import AiRecipePanel from '../../components/recipes/AiRecipePanel.astro';
import RecipeForm from '../../components/recipes/RecipeForm.astro';
import Alert from '../../components/ui/Alert.astro';
import Panel from '../../components/ui/Panel.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import { getAiSettings } from '../../lib/ai';
import { getDb } from '../../lib/db';
import { useTranslations } from '../../lib/i18n';

let databaseError = '';
let aiConfigured = false;
try {
	aiConfigured = Boolean(await getAiSettings(getDb(), Astro.locals.userId));
} catch (error) {
	databaseError = error instanceof Error ? error.message : 'Unknown database error';
}

const { t } = useTranslations(Astro);
const aiError = Astro.url.searchParams.get('ai_error') ?? undefined;
---

<AppLayout active="recipes" title={t('newRecipe')}>
	<section class="grid gap-4">
		<PageHeader title={t('newRecipe')} backHref="/recipes" backLabel={t('recipes')} />
		{databaseError && (
			<Alert title={t('databaseSetupNeeded')}>
				<p class="m-0">{databaseError}</p>
			</Alert>
		)}
		<AiRecipePanel mode="generate" configured={aiConfigured} error={aiError} />
		<Panel>
			<RecipeForm disabled={Boolean(databaseError)} />
		</Panel>
	</section>
</AppLayout>
