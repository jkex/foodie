---
import { ChevronRight, Plus, Search } from '@lucide/astro';
import PageHeader from '../../components/PageHeader.astro';
import Alert from '../../components/ui/Alert.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Input from '../../components/ui/Input.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import { getDb, listRecipes, type Recipe } from '../../lib/db';
import { formatLastCooked, useTranslations } from '../../lib/i18n';
import { translateRecipe } from '../../lib/preferences';

let recipes: Recipe[] = [];
let databaseError = '';

try {
	recipes = await listRecipes(getDb(), Astro.locals.userId);
} catch (error) {
	databaseError = error instanceof Error ? error.message : 'Unknown database error';
}

const { locale, t } = useTranslations(Astro);
const query = (Astro.url.searchParams.get('q') ?? '').trim();
const visibleRecipes = query
	? recipes.filter((recipe) => `${recipe.name} ${recipe.description}`.toLowerCase().includes(query.toLowerCase()))
	: recipes;
---

<AppLayout active="recipes" title={t('recipesNav')}>
	<section class="grid gap-4">
		<PageHeader title={t('recipes')}>
			<Button slot="action" href="/recipes/new">
				<Plus size={16} stroke-width={2} />
				{t('newRecipe')}
			</Button>
		</PageHeader>

		{
			databaseError && (
				<Alert title={t('databaseSetupNeeded')}>
					<p class="m-0">{databaseError}</p>
				</Alert>
			)
		}

		<form method="get" action="/recipes" class="relative">
			<Search size={16} stroke-width={2} class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-neutral-400" />
			<Input type="search" name="q" value={query} placeholder={t('searchRecipes')} aria-label={t('searchRecipes')} class="pl-9" />
		</form>

		{
			visibleRecipes.length > 0 ? (
				<div class="grid gap-3">
					{visibleRecipes.map((r) => {
						const recipe = translateRecipe(locale, r);
						const lastCooked = formatLastCooked(locale, recipe.last_cooked_at);
						return (
							<a
								href={`/recipes/${recipe.id}`}
								class="group grid grid-cols-[1fr_auto] items-center gap-3 rounded-2xl border border-neutral-200/80 bg-white p-4 text-inherit no-underline shadow-sm transition hover:border-primary-300 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-primary-700"
							>
								<span class="grid gap-1.5">
									<strong class="text-base font-semibold">{recipe.name}</strong>
									<small class="text-sm text-neutral-500 dark:text-neutral-400">{recipe.description || t('noDescription')}</small>
									<span class="mt-1 flex flex-wrap gap-1.5">
										<Badge>
											{recipe.base_servings} {t('baseServings').toLowerCase()}
										</Badge>
										<Badge>
											{recipe.default_days} {recipe.default_days === 1 ? t('daySingular') : t('dayPlural')}
										</Badge>
										<Badge tone={lastCooked ? 'primary' : 'warning'}>
											{lastCooked ? `${t('lastCooked')}: ${lastCooked}` : t('neverCooked')}
										</Badge>
									</span>
								</span>
								<ChevronRight
									size={18}
									stroke-width={2}
									class="text-neutral-300 transition group-hover:text-primary-600 dark:text-neutral-600 dark:group-hover:text-primary-400"
								/>
							</a>
						);
					})}
				</div>
			) : (
				!databaseError && (
					<EmptyState title={query ? t('noSearchResults') : t('noRecipes')} description={query ? undefined : t('recipesEmptyHelp')}>
						{!query && (
							<Button variant="secondary" href="/recipes/new">
								{t('newRecipe')}
							</Button>
						)}
					</EmptyState>
				)
			)
		}
	</section>
</AppLayout>
