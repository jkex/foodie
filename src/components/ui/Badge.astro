---
type Tone = 'neutral' | 'primary' | 'warning';

const { tone = 'neutral', class: className = '' } = Astro.props as { tone?: Tone; class?: string };

const tones: Record<Tone, string> = {
	neutral: 'bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300',
	primary: 'bg-primary-100 text-primary-800 dark:bg-primary-950 dark:text-primary-300',
	warning: 'bg-warning-100 text-warning-800 dark:bg-warning-950 dark:text-warning-300',
};
---

<span class:list={['inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium', tones[tone], className]}>
	<slot />
</span>
