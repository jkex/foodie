---
import { Info } from '@lucide/astro';

const {
	label,
	align = 'center',
	placement = 'bottom',
	class: className = '',
} = Astro.props as {
	label: string;
	align?: 'left' | 'center' | 'right';
	placement?: 'top' | 'bottom';
	class?: string;
};

// Pure-CSS reveal: hover for pointers, focus-within for keyboard + mobile tap
// (tapping the button focuses it). No JS needed.
const position = [
	placement === 'top' ? 'bottom-full mb-2' : 'top-full mt-2',
	{ left: 'left-0', center: 'left-1/2 -translate-x-1/2', right: 'right-0' }[align],
];
---

<span class:list={['group relative inline-block align-middle w-5 h-5 shrink-0', className]}>
	<button
		type="button"
		aria-label={label}
		class="inline-flex h-5 w-5 items-center justify-center rounded-full text-neutral-400 transition hover:text-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:text-neutral-500 dark:hover:text-neutral-200"
	>
		<Info size={14} stroke-width={2} />
	</button>
	<span
		role="tooltip"
		data-align={align}
		class:list={[
			'pointer-events-none absolute z-50 w-56 max-w-[80vw] rounded-xl border border-neutral-200 bg-white p-3 text-left text-xs leading-relaxed font-normal text-neutral-600 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300',
			'hidden group-hover:block group-hover:animate-tooltip-in group-focus-within:block group-focus-within:animate-tooltip-in',
			...position,
		]}
	>
		<slot />
	</span>
</span>

<script>
	function adjustTooltip(tooltip: HTMLElement) {
		const isHidden = window.getComputedStyle(tooltip).display === 'none';
		if (isHidden) {
			tooltip.style.display = 'block';
		}

		// Reset inline layout and transform styles so we measure the original element dimensions
		tooltip.style.left = '';
		tooltip.style.right = '';
		tooltip.style.transform = '';

		const rect = tooltip.getBoundingClientRect();
		const parentRect = tooltip.parentElement ? tooltip.parentElement.getBoundingClientRect() : null;
		const viewportWidth = window.innerWidth;
		const margin = 8; // Keep 8px gap from screen edges

		if (parentRect) {
			// Measure available screen space on both sides of the parent element
			const spaceOnLeft = parentRect.right;
			const spaceOnRight = viewportWidth - parentRect.left;

			// Check where we have enough room to fit the tooltip box
			if (spaceOnRight < rect.width + margin && spaceOnLeft > spaceOnRight) {
				// Not enough space on the right, and more space on the left: Align to the right (extends to the left)
				tooltip.style.left = 'auto';
				tooltip.style.right = '0';
			} else if (spaceOnLeft < rect.width + margin && spaceOnRight > spaceOnLeft) {
				// Not enough space on the left, and more space on the right: Align to the left (extends to the right)
				tooltip.style.left = '0';
				tooltip.style.right = 'auto';
			} else {
				// Default to center alignment
				tooltip.style.left = '50%';
				tooltip.style.right = 'auto';
				tooltip.style.transform = 'translateX(-50%)';
			}
		}

		// Apply fine-tuning offset if the aligned tooltip still clips the screen edges (e.g. extremely narrow devices)
		const newRect = tooltip.getBoundingClientRect();
		let offset = 0;
		if (newRect.left < margin) {
			offset = margin - newRect.left;
		} else if (newRect.right > viewportWidth - margin) {
			offset = viewportWidth - margin - newRect.right;
		}

		if (offset !== 0) {
			const currentTransform = tooltip.style.transform;
			if (currentTransform) {
				tooltip.style.transform = `${currentTransform} translateX(${offset}px)`;
			} else {
				tooltip.style.transform = `translateX(${offset}px)`;
			}
		}

		if (isHidden) {
			tooltip.style.display = '';
		}
	}

	const handleEvent = (e: Event) => {
		const target = e.target as HTMLElement;
		if (target && target.closest) {
			const group = target.closest('.group');
			if (group) {
				const tooltip = group.querySelector('[role="tooltip"]') as HTMLElement;
				if (tooltip) {
					adjustTooltip(tooltip);
				}
			}
		}
	};

	// Event delegation to capture focus, hover, and mobile touch/tap interactions
	document.addEventListener('mouseenter', handleEvent, true);
	document.addEventListener('focusin', handleEvent, true);
	document.addEventListener('touchstart', handleEvent, { capture: true, passive: true });
</script>
