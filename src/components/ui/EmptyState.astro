---
const { title, description } = Astro.props as { title: string; description?: string };
---

<div class="grid justify-items-center gap-2 rounded-2xl border border-dashed border-neutral-300 bg-neutral-50/60 px-4 py-10 text-center dark:border-neutral-700 dark:bg-neutral-900/40">
	<p class="m-0 text-base font-semibold text-neutral-800 dark:text-neutral-200">{title}</p>
	{description && <p class="m-0 max-w-sm text-sm text-neutral-500 dark:text-neutral-400">{description}</p>}
	<slot />
</div>
