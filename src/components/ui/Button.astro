---
type Variant = 'primary' | 'secondary' | 'danger';

const {
	variant = 'primary',
	href,
	type = 'submit',
	class: className = '',
	...rest
} = Astro.props as {
	variant?: Variant;
	href?: string;
	type?: 'submit' | 'button';
	class?: string;
	[key: string]: unknown;
};

const variants: Record<Variant, string> = {
	primary: 'bg-primary-600 text-white shadow-sm hover:bg-primary-700 dark:bg-primary-500 dark:text-primary-950 dark:hover:bg-primary-400',
	secondary:
		'border border-neutral-200 bg-white text-neutral-950 shadow-xs hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-50 dark:hover:bg-neutral-800',
	danger:
		'border border-red-200 bg-white text-red-700 shadow-xs hover:bg-red-50 dark:border-red-900 dark:bg-neutral-900 dark:text-red-400 dark:hover:bg-red-950/40',
};

const classes = [
	'inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold transition disabled:pointer-events-none disabled:opacity-50 no-underline',
	variants[variant],
	className,
];
---

{
	href ? (
		<a href={href} class:list={classes} {...rest}>
			<slot />
		</a>
	) : (
		<button type={type} class:list={classes} {...rest}>
			<slot />
		</button>
	)
}
