---
const { class: className = '', ...rest } = Astro.props as { class?: string; [key: string]: unknown };
---

<input
	class:list={[
		'h-11 w-full rounded-xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-950 shadow-xs outline-none transition focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-50 dark:focus:border-primary-400 dark:focus:ring-primary-400/20',
		className,
	]}
	{...rest}
/>
