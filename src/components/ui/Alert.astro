---
const { title } = Astro.props as { title?: string };
---

<section
	class="rounded-2xl border border-warning-200 bg-warning-50 p-4 text-sm text-warning-950 dark:border-warning-900 dark:bg-warning-950 dark:text-warning-100"
>
	{title && <h2 class="mt-0 mb-1 text-base font-semibold">{title}</h2>}
	<slot />
</section>
