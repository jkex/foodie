---
import { X } from '@lucide/astro';
import { INGREDIENT_CATEGORIES, translateCategory, translateIngredient, type Locale } from '../../lib/preferences';
import { useTranslations } from '../../lib/i18n';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';

const { ingredient, disabled = false } = Astro.props as {
	ingredient?: { name: string; quantity: number; unit: string; category: string; note: string };
	disabled?: boolean;
};
const { locale, t } = useTranslations(Astro);
const categories: Array<{ value: string; label: string }> = INGREDIENT_CATEGORIES.map((category) => ({
	value: category,
	label: translateCategory(locale as Locale, category),
}));
const selectedCategory = ingredient?.category ?? 'Other';
---

<fieldset
	class="m-0 grid grid-cols-[1fr_auto] items-start gap-2 rounded-xl border border-neutral-200 bg-neutral-50/70 p-3 dark:border-neutral-800 dark:bg-neutral-950/60"
	data-ingredient-row
>
	<div class="grid gap-2 sm:grid-cols-[2fr_1fr_1fr]">
		<Input
			name="ingredient_name"
			placeholder={t('ingredientNamePlaceholder')}
			aria-label={t('ingredient')}
			value={translateIngredient(locale as Locale, ingredient?.name ?? '')}
			disabled={disabled}
		/>
		<Input
			name="ingredient_quantity"
			type="number"
			min="0"
			step="any"
			placeholder={t('quantity')}
			aria-label={t('quantity')}
			value={ingredient ? String(ingredient.quantity) : ''}
			disabled={disabled}
		/>
		<Input name="ingredient_unit" placeholder={t('unit')} aria-label={t('unit')} value={ingredient?.unit ?? ''} disabled={disabled} />
		<Select name="ingredient_category" aria-label={t('category')} class="sm:col-span-2" disabled={disabled}>
			{
				categories.map((category) => (
					<option value={category.value} selected={category.value === selectedCategory}>
						{category.label}
					</option>
				))
			}
		</Select>
		<Input
			name="ingredient_note"
			placeholder={`${t('note')} (${t('notePlaceholder')})`}
			aria-label={t('note')}
			value={ingredient?.note ?? ''}
			disabled={disabled}
		/>
	</div>
	<button
		type="button"
		data-remove-ingredient
		aria-label={t('remove')}
		disabled={disabled}
		class="grid h-9 w-9 cursor-pointer place-items-center rounded-lg border border-neutral-200 bg-white text-neutral-500 transition hover:bg-neutral-100 hover:text-red-600 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-red-400 disabled:pointer-events-none disabled:opacity-50"
	>
		<X size={16} stroke-width={2} />
	</button>
</fieldset>
