{
  "name": "foodie",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:migrations:local": "wrangler d1 migrations apply foodie --local",
    "db:migrations:remote": "wrangler d1 migrations apply foodie --remote",
    "pages:dev": "npm run build && wrangler pages dev dist --d1 DB=foodie"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "astro": "^6.4.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260611.1",
    "wrangler": "^4.100.0"
  }
}
